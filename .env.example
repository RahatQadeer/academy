# Shared Supabase project for the whole Private Attaché ecosystem.
# Set these once on the Vercel project — do not generate per-module copies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production origin for auth emails and OAuth callbacks.
# Local `next dev` always uses http://localhost:3000 instead of this value.
NEXT_PUBLIC_SITE_URL=https://private-attache-dun.vercel.app

# Switcher behavior for products the user is not entitled to.
# "grey" = show the card muted with an apply/explore action (default)
# "hide" = omit unentitled products from the grid
NEXT_PUBLIC_SWITCHER_UNENTITLED=grey

# TEMPORARY — Brent’s capped course-builder instructor (remove when retired).
# Comma-separated emails get a max course/Whitby-gen cap (default 10).
# ACADEMY_TEMP_INSTRUCTOR_EMAILS=academy.temp.builder@righttail.org
# ACADEMY_TEMP_INSTRUCTOR_COURSE_CAP=10

# How long the link inside a Supabase auth email stays usable, in seconds.
# This is NOT a setting the app applies — it mirrors the Supabase project's own
# `mailer_otp_exp` (Authentication → Sign In / Providers → Email OTP Expiration),
# which is 3600 there today. An invitation row lives for 14 days, but the
# address in the email is a Supabase /auth/v1/verify link that dies after this
# many seconds, so the Clients list reads "Link expired" rather than "Pending"
# once it has passed. Raise it here only to match a change made in Supabase.
SUPABASE_EMAIL_LINK_TTL_SECONDS=3600

# Shared secret for scheduled routes under /api/cron/. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET` on its own once the variable is set on
# the project; set the same value here to call those routes by hand. With no
# value set the routes refuse every request, which is deliberate.
CRON_SECRET=

# Server-only AI key for Academy Admin course generation (DeepSeek).
DEEPSEEK_API_KEY=
# Optional DeepSeek model override (default: deepseek-chat — fast conversation).
# COURSEGEN_MODEL_WRITING=deepseek-chat
# Opt-in slower reasoner only for full-program rewrites (Whitby task=reason):
# COURSEGEN_MODEL_REASONING=deepseek-reasoner

# Stripe — shared secret (Partner Connect + Academy checkout). Use Test mode locally.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Partner Center Connect webhook: POST /api/partner-center/stripe/webhook
# Subscribe at least: account.updated, account.application.deauthorized
STRIPE_WEBHOOK_SECRET=
# Academy paid checkout (dynamic price_data from academy_programs).
# Prefer Academy-scoped secret (endpoint: /api/academy/checkout/webhook).
STRIPE_ACADEMY_WEBHOOK_SECRET=
# Whitby plan subscriptions AND client invoice payment, which share one
# endpoint: POST /api/whitbyos/billing/webhook
# Subscribe at least: checkout.session.completed,
# checkout.session.async_payment_succeeded, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted,
# customer.subscription.trial_will_end, invoice.paid, invoice.payment_failed
STRIPE_WHITBY_WEBHOOK_SECRET=

# A second signing secret for the same route, verified when the one above does
# not match. It exists so a second dashboard endpoint pointing at this same URL
# — the client-portal invoice one — can be added without taking the first
# endpoint's secret away from whoever is already using it. Leave it empty if
# there is only one endpoint. Rotation works the same way: set the new secret
# here, wait for deliveries to move, then clear the old one.
STRIPE_PORTAL_WEBHOOK_SECRET=

# Whitby's plan catalogue. Each plan is a fixed price plus the metered AI price
# beside it; Enterprise is quoted by hand, so it has a meter and no plan price.
# Without these, Settings > Billing can show plans but cannot sell one.
STRIPE_AI_METER_ID=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_STANDARD_AI=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_PROFESSIONAL_AI=
STRIPE_PRICE_TEAMS=
STRIPE_PRICE_TEAMS_AI=
STRIPE_PRICE_ENTERPRISE_AI=

# Whitby AI billing — profit as a fraction of the actual LLM cost.
# Unset means 0.5: the profit is half the cost, so cost 100 is charged at 150.
# 0 bills at cost. The rate lives only in whitbyos/lib/ai/cost.ts, which reads
# this; nothing else multiplies. There is no per-plan AI allowance.
# WHITBY_AI_MARKUP_RATE=0.5

# Gemini token pricing — REQUIRED before any AI usage can be costed or billed.
# Google's published rates in USD per million tokens, for the model in
# GEMINI_MODEL. Both must be set: pricing input but not output would produce a
# cost that is confidently too low rather than honestly absent. Until they are
# set, token counts are still recorded and cost/charge stay null, and nothing
# is reported to Stripe. No default is assumed — an invented rate would be
# charged to a customer.
# GEMINI_INPUT_COST_PER_MTOK=
# GEMINI_OUTPUT_COST_PER_MTOK=

# Partner Center collections webhook (enterprise opportunity Stripe payments).
# Endpoint: /api/partner-center/stripe/collections/webhook
STRIPE_COLLECTIONS_WEBHOOK_SECRET=

# Partner attribution shared secret (Academy / Whitby → partner-center).
PARTNER_ATTRIBUTION_SECRET=

# Intuit QuickBooks Online — platform Enterprise payment matching (§17.15.4–5).
# OAuth: /api/partner-center/quickbooks/start|callback
# Webhook: /api/partner-center/quickbooks/webhook
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_WEBHOOK_VERIFIER_TOKEN=
# sandbox | production (default sandbox)
INTUIT_ENVIRONMENT=sandbox

# Required for Super Admin staff sessions (min 32 chars). Never reuse the service role key.
# Generate: openssl rand -base64 48
SUPER_ADMIN_SESSION_SECRET=
# Force Secure/__Host- cookies on local HTTPS if needed.
# SUPER_ADMIN_COOKIE_SECURE=1

# Google and Microsoft app identities, for the calendar and mailbox a client
# connects on Integrations (client-portal/018) and the ones a professional
# connects in Whitby.
#
# A provider with no client id AND secret here is drawn on the Integrations
# screen with a Connect button that opens "… isn't available yet" instead of
# starting the round trip — `oauthConfigured` in
# `client-portal/lib/integrations/providers.ts` is the gate. That dialog means
# these variables, nothing else.
#
# Every redirect URI has to be registered with the provider as well, or consent
# comes back `redirect_uri_mismatch`. For each origin the portal runs on:
#   Google  — /api/client-portal/integrations/gmail/callback
#             /api/client-portal/integrations/google_calendar/callback
#             /api/whitbyos/integrations/google/callback
#   Entra   — /api/client-portal/integrations/outlook_mail/callback
#             /api/client-portal/integrations/outlook_calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# The Entra tenant consent is asked of. `common` lets any Microsoft account —
# work, school or personal — connect, which is what a client needs; a single
# tenant id restricts it to one organisation.
MICROSOFT_TENANT_ID=common
